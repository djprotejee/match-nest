# MatchNest backend environment.
#
# F1 works without a token through the Jolpica Ergast-compatible API.
# Football and CS2 tokens are optional for local boot, but required for those
# real providers to return data.

# Optional production database. Leave empty locally to use SQLite at
# backend/.data/matchnest.sqlite. Set this on Render to a free Neon Postgres
# connection string so accounts, follows, custom entities, and cache persist.
DATABASE_URL=

FOOTBALL_DATA_TOKEN=
# Optional provider-specific team IDs. Use this when football-data team
# discovery hits rate limits or misses a followed team.
# Format: entity_id:provider_team_id,entity_id:provider_team_id
# Example shape only, do not copy values without verifying them:
# FOOTBALL_DATA_TEAM_IDS=barcelona:0,ukraine_nt:0
FOOTBALL_DATA_TEAM_IDS=

# Primary football team-fixtures provider. Recommended for full followed-team
# calendars such as Ukraine NT and FC Barcelona.
API_FOOTBALL_TOKEN=
# Keep disabled on the free plan for future seasons. Enable only for a paid plan
# or explicit testing, because the free plan can reject modern seasons.
API_FOOTBALL_ENABLE=0
# Optional provider-specific API-Football team IDs. The provider can search by
# name, but explicit IDs are more reliable and save requests.
# API_FOOTBALL_TEAM_IDS=barcelona:0,ukraine_nt:0
API_FOOTBALL_TEAM_IDS=

# Optional free football fallback for national team fixtures. Defaults to the
# public TheSportsDB key 3 when omitted.
THESPORTSDB_API_KEY=
PANDASCORE_TOKEN=
# Optional future CS2 stats provider. GRID Open Access can provide CS2 map,
# player, team, and in-game stats after access is approved.
GRID_API_TOKEN=

# Required for browser/iPhone push notifications. Generate a VAPID key pair once
# and keep the private key secret. VAPID_SUBJECT is usually your email.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret used by an external cron worker to run background refreshes and
# notification dispatch without a user login session.
NOTIFICATION_DISPATCH_TOKEN=

# Public base URL used in email verification links after deployment.
# Example: APP_PUBLIC_URL=https://match-nest.example.com
APP_PUBLIC_URL=

# Optional SMTP settings for real email verification. When SMTP_HOST is empty,
# MatchNest writes local development verification links to backend/.data/dev-emails.log
# and returns the link from /auth/register for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Google OAuth login. GOOGLE_REDIRECT_URI must match the redirect URI
# configured in Google Cloud OAuth settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Keep this disabled for product use. Enable only when developing the UI without
# network access or API tokens.
MATCHNEST_ALLOW_DEMO_EVENTS=0
